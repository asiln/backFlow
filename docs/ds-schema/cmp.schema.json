{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asiln/figma-lift/docs/ds-schema/cmp.schema.json",
  "title": "Figma Lift: CmpRef and Override (spec 7.1)",
  "description": "The `cmp` field written by componentize.mjs on a node that is an instance of a library component (id 'cmp_...') or icon (id 'ic_...'). Slot ids `s` are the slot's index (decimal string) in the component's `slots[]`; a slot inside a nested instance is '<outer inst slot>.<inner slot>' (e.g. '2.1').",
  "$defs": {
    "SlotId": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
    "VariantMap": { "type": "object", "additionalProperties": { "type": "string" }, "minProperties": 1 },
    "Override": {
      "anyOf": [
        { "title": "text", "type": "object", "required": ["s", "t"], "additionalProperties": false,
          "properties": { "s": { "$ref": "#/$defs/SlotId" }, "t": { "type": "string" }, "r": { "type": "array", "description": "runs (mixed styling): direct text override, then re-apply runs", "items": { "type": "object", "required": ["s", "e"] } } } },
        { "title": "bool", "type": "object", "required": ["s", "b"], "additionalProperties": false,
          "properties": { "s": { "$ref": "#/$defs/SlotId" }, "b": { "type": "boolean" } } },
        { "title": "swap", "type": "object", "required": ["s", "ic"], "additionalProperties": false,
          "properties": { "s": { "$ref": "#/$defs/SlotId" }, "ic": { "type": "string", "pattern": "^ic_" }, "c": { "$ref": "tok.schema.json#/$defs/ColourKey" }, "sz": { "type": "number", "exclusiveMinimum": 0 } } },
        { "title": "img", "type": "object", "required": ["s", "img"], "additionalProperties": false,
          "properties": { "s": { "$ref": "#/$defs/SlotId" }, "img": { "type": "object", "additionalProperties": false, "properties": { "asset": { "type": "string" }, "data": { "type": "string" }, "fit": { "type": "string", "enum": ["FILL", "FIT", "CROP", "TILE"] }, "tf": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } } } } } },
        { "title": "paint", "type": "object", "required": ["s"], "additionalProperties": false,
          "properties": { "s": { "$ref": "#/$defs/SlotId" }, "fill": { "$ref": "node.schema.json#/$defs/RGBA" }, "fillTok": { "$ref": "tok.schema.json#/$defs/ColourKey" }, "stroke": { "$ref": "node.schema.json#/$defs/RGBA" }, "strokeTok": { "$ref": "tok.schema.json#/$defs/ColourKey" }, "op": { "type": "number", "minimum": 0, "maximum": 1 } },
          "anyOf": [{ "required": ["fill"] }, { "required": ["fillTok"] }, { "required": ["stroke"] }, { "required": ["strokeTok"] }, { "required": ["op"] }] },
        { "title": "inst", "type": "object", "required": ["s", "v"], "additionalProperties": false,
          "properties": { "s": { "$ref": "#/$defs/SlotId" }, "v": { "$ref": "#/$defs/VariantMap" } } }
      ]
    },
    "CmpRef": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(cmp|ic)_[A-Za-z0-9_-]+$" },
        "kind": { "enum": ["component", "icon"], "description": "default 'component'; icons use 'icon' (spec 3.3 example, missing from 7.1)" },
        "v": { "$ref": "#/$defs/VariantMap" },
        "ov": { "type": "array", "items": { "$ref": "#/$defs/Override" } },
        "sz": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": ["number", "null"] } },
        "c": { "$ref": "tok.schema.json#/$defs/ColourKey", "description": "icon colour token key (spec 3.3 `c`)" },
        "dev": { "type": "number", "minimum": 0 },
        "conf": { "type": "number", "minimum": 0, "maximum": 100 },
        "rej": { "type": "string" },
        "stripped": { "type": "boolean" }
      }
    }
  },
  "$ref": "#/$defs/CmpRef"
}
