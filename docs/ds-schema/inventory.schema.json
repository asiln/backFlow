{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asiln/backflow/docs/ds-schema/inventory.schema.json",
  "title": "Backflow: ds-inventory.json (spec 7.3)",
  "description": "Snapshot of the design system that already exists in the Figma file, written by plugin-tokens 'Export inventory'. valuesByMode is keyed by MODE ID (see collections[].modes); colour values are {r,g,b,a} floats, aliases are {type:'VARIABLE_ALIAS', id}.",
  "type": "object",
  "required": ["file", "generated", "collections", "variables", "paintStyles", "textStyles", "effectStyles", "components", "icons"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "file": { "type": "string" },
    "generated": { "type": "string" },
    "collections": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "name", "modes"], "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "modes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } } }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "key", "name", "collection", "type", "scopes", "valuesByMode"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "key": { "type": "string" }, "name": { "type": "string" },
          "collection": { "type": "string", "description": "collection id" },
          "type": { "enum": ["COLOR", "FLOAT", "STRING", "BOOLEAN"] },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "valuesByMode": { "type": "object" },
          "codeSyntax": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    },
    "paintStyles": { "type": "array", "items": { "type": "object", "required": ["id", "key", "name", "paints"], "properties": { "id": { "type": "string" }, "key": { "type": "string" }, "name": { "type": "string" }, "paints": { "type": "array" } } } },
    "textStyles": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "key", "name", "fontName", "fontSize", "lineHeight", "letterSpacing"],
        "properties": {
          "id": { "type": "string" }, "key": { "type": "string" }, "name": { "type": "string" },
          "fontName": { "type": "object", "required": ["family", "style"] },
          "fontSize": { "type": "number" },
          "lineHeight": { "type": "object", "required": ["unit"] },
          "letterSpacing": { "type": "object", "required": ["unit", "value"] }
        }
      }
    },
    "effectStyles": { "type": "array", "items": { "type": "object", "required": ["id", "key", "name", "effects"], "properties": { "id": { "type": "string" }, "key": { "type": "string" }, "name": { "type": "string" }, "effects": { "type": "array" } } } },
    "components": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "key", "name", "type", "page", "props", "fingerprint"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "key": { "type": "string" }, "name": { "type": "string" },
          "type": { "enum": ["COMPONENT", "COMPONENT_SET"] },
          "page": { "type": "string" },
          "props": {
            "type": "object",
            "additionalProperties": {
              "type": "object", "required": ["type"],
              "properties": { "type": { "enum": ["BOOLEAN", "TEXT", "INSTANCE_SWAP", "VARIANT", "SLOT"] }, "defaultValue": { "type": ["string", "boolean"] }, "variantOptions": { "type": "array", "items": { "type": "string" } } }
            }
          },
          "variants": { "type": "array", "items": { "type": "string" } },
          "fingerprint": { "$ref": "#/$defs/Fingerprint" }
        }
      }
    },
    "icons": { "type": "array", "items": { "type": "object", "required": ["id", "key", "name"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "key": { "type": "string" }, "name": { "type": "string" }, "geom": { "type": "string" } } } }
  },
  "$defs": {
    "Fingerprint": {
      "description": "Spec 2.8.1: same mapping as view(): {t, k, s, kids, fills, radius, h, pad, gap}. For component sets: {variants: {'Prop=Value, ...': Fingerprint}} is also accepted.",
      "type": "object",
      "properties": {
        "t": { "enum": ["frame", "text", "svg", "img"] },
        "k": { "enum": ["H", "V", "W", "G", "N"] },
        "s": { "type": "array", "items": { "enum": ["F", "H", "L"] } },
        "kids": { "type": "array", "items": { "$ref": "#/$defs/Fingerprint" } },
        "fills": { "type": "array", "items": { "type": "string" }, "description": "token key or rgba key per paint" },
        "radius": { "type": "number" }, "h": { "type": "number" }, "pad": { "type": "array", "items": { "type": "number" } }, "gap": { "type": "number" },
        "variants": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Fingerprint" } }
      },
      "additionalProperties": true
    }
  }
}
