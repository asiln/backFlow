{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asiln/backflow/docs/ds-schema/screen-file.schema.json",
  "title": "Backflow: export file (*.figma.json), plain or enriched",
  "description": "Top level of an export. `figmaLift: 1` is what extract.mjs writes today. An enriched file (out/enriched/<file>.figma.json) additionally has `ds` pointing at the library and tokens files.",
  "type": "object",
  "required": ["figmaLift", "frames"],
  "properties": {
    "figmaLift": { "const": 1 },
    "name": { "type": "string" },
    "assets": { "type": "object", "additionalProperties": { "type": "string" } },
    "ds": {
      "type": "object", "required": ["library", "ver"], "additionalProperties": false,
      "properties": { "library": { "type": "string" }, "tokens": { "type": "string" }, "ver": { "const": 1 } }
    },
    "frames": { "type": "array", "minItems": 1, "items": { "$ref": "node.schema.json#/$defs/Node" } }
  },
  "additionalProperties": true
}
