      "$type": "color",
      "$value": "#fbecd3",
      "$extensions": {
        "mode.dark": "#3d3a3a"
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Archivo",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 640,
        "fontSize": "64px",
        "lineHeight": "64px",
        "letterSpacing": "-0.03em",
        "fontStretch": "118%"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 620,
        "fontSize": "40px",
        "lineHeight": "44px",
        "letterSpacing": "-0.02em",
        "fontStretch": "112%"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 600,
        "fontSize": "24px",
        "lineHeight": "30px",
        "letterSpacing": "-0.01em",
        "fontStretch": "108%"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 400,
        "fontSize": "17px",
        "lineHeight": "27px",
        "fontStretch": "100%"
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": "21px",
        "fontStretch": "100%"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 600,
        "fontSize": "11px",
        "lineHeight": "16px",
        "letterSpacing": "0.08em",
        "fontStretch": "78%",
        "textTransform": "uppercase"
      }
    },
    "dim": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 500,
        "fontSize": "11px",
        "lineHeight": "16px"
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 400,
        "fontSize": "14px",
        "lineHeight": "22px"
      }
    }
  },
  "radius": {
    "1": {
      "$type": "dimension",
      "$value": "2px"
    },
    "2": {
      "$type": "dimension",
      "$value": "4px"
    },
    "3": {
      "$type": "dimension",
      "$value": "6px"
    }
  },
  "stroke": {
    "hair": {
      "$type": "dimension",
      "$value": "1px"
    },
    "rule": {
      "$type": "dimension",
      "$value": "1.5px"
    }
  },
  "space": {
    "4": {
      "$type": "dimension",
      "$value": "4px"
    },
    "8": {
      "$type": "dimension",
      "$value": "8px"
    },
    "12": {
      "$type": "dimension",
      "$value": "12px"
    },
    "16": {
      "$type": "dimension",
      "$value": "16px"
    },
    "24": {
      "$type": "dimension",
      "$value": "24px"
    },
    "32": {
      "$type": "dimension",
      "$value": "32px"
    },
    "48": {
      "$type": "dimension",
      "$value": "48px"
    },
    "72": {
      "$type": "dimension",
      "$value": "72px"
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "fast": {
      "$type": "duration",
      "$value": "120ms"
    },
    "base": {
      "$type": "duration",
      "$value": "200ms"
    },
    "draw": {
      "$type": "duration",
      "$value": "900ms"
    }
  }
}
